CREATE OR REPLACE PROCEDURE bronze.load_bronze ()
LANGUAGE plpgsql AS
$$
BEGIN 

	RAISE NOTICE 'Start Task' ;
	
	RAISE NOTICE 'Start Imoprting Data From crm_cust_info' ;
	
	TRUNCATE TABLE bronze.crm_cust_info;
    COPY bronze.crm_cust_info 
    FROM '/run/media/mahmoud-atef/Data/Projects/DWH/Datasets/CRM Source/cust_info.csv' 
    DELIMITER ',' 
    CSV HEADER;

